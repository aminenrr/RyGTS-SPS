+// FORK-PRECOMPILE: the stored permutation index of a program's translation with this SPIR-V hash
+// (programs the store had before pre-translation), or ~0u.
+static u32 FindStoredPermutation(u64 pgm, u64 spv_xxh,
+                                 std::unordered_map<u64, std::vector<u64>>& stored_hashes) {
+    auto [it, added] = stored_hashes.try_emplace(pgm);
+    if (added) {
+        auto& store = Storage::DataBase::Instance();
+        u32 gap = 0;
+        for (u32 i = 0; i < 64 && gap < 8; ++i) {
+            const auto name = fmt::format("{:#018x}_{}", pgm, i);
+            if (!store.Exists(Storage::BlobType::ShaderBinary, name)) {
+                it->second.push_back(0);
+                ++gap;
+                continue;
+            }
+            gap = 0;
+            std::vector<u32> words;
+            store.Load(Storage::BlobType::ShaderBinary, name, words);
+            it->second.push_back(words.empty() ? 0 : XXH3_64bits(words.data(), words.size() * 4));
+        }
+    }
+    for (size_t i = 0; i < it->second.size(); ++i) {
+        if (it->second[i] == spv_xxh) {
+            return u32(i);
+        }
+    }
+    return ~0u;
+}
