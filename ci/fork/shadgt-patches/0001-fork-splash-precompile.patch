+// FORK-PRECOMPILE: a record's code from the launcher's program folder when the capture has none.
+// The renderer hashes the code from its start for bininfo.length bytes (code_words); the program
+// file starts at the same first word and runs past it to the footer, so its first code_words
+// words are the code when their XXH3 is the record's. The match is kept in the capture.
+static std::vector<u32> ReadProgramCode(u64 hash, u64 code_xxh, u32 code_words) {
+    if (g_programs_dir.empty() || code_words == 0) {
+        return {};
+    }
+    std::vector<u8> bytes;
+    if (std::FILE* f = std::fopen((g_programs_dir / fmt::format("{:016x}.bin", hash)).string().c_str(),
+                                  "rb")) {
+        std::fseek(f, 0, SEEK_END);
+        const long size = std::ftell(f);
+        std::fseek(f, 0, SEEK_SET);
+        if (size >= long(code_words) * 4) {
+            bytes.resize(size_t(code_words) * 4);
+            if (std::fread(bytes.data(), 1, bytes.size(), f) != bytes.size()) bytes.clear();
+        }
+        std::fclose(f);
+    }
+    if (bytes.empty() || XXH3_64bits(bytes.data(), bytes.size()) != code_xxh) {
+        return {};
+    }
+    std::vector<u32> words(code_words);
+    std::memcpy(words.data(), bytes.data(), bytes.size());
+    WriteWords(g_capture_dir / fmt::format("{:016x}-{:016x}.code", hash, code_xxh), words);
+    return words;
+}
