+// FORK-PRECOMPILE: stores the keys of the pipeline records whose stages are all in the store now
+// (with the store's indices). Returns the number stored; keys the store has are left alone.
+static u32 RestoreManifestPipelines(std::stop_token stop,
+                                    const std::unordered_map<u64, u32>& resolved, u32& unresolved,
+                                    u32& records) {
+    u32 restored = 0;
+    unresolved = 0;
+    records = 0;
+    if (!ManifestPipelinesOn()) {
+        return 0;
+    }
+    auto& store = Storage::DataBase::Instance();
+    std::unordered_map<u64, std::vector<u64>> stored_hashes;
+    std::error_code ec;
+    for (const auto& entry :
+         std::filesystem::directory_iterator(g_manifest_dir / "pipelines", ec)) {
+        if (stop.stop_requested()) break;
+        if (entry.path().extension() != ".pip") continue;
+        ++records;
+        std::vector<u8> in;
+        if (std::FILE* f = std::fopen(entry.path().string().c_str(), "rb")) {
+            std::fseek(f, 0, SEEK_END);
+            const long size = std::ftell(f);
+            std::fseek(f, 0, SEEK_SET);
+            if (size > 0 && size < (1 << 20)) {
+                in.resize(size_t(size));
+                if (std::fread(in.data(), 1, in.size(), f) != in.size()) in.clear();
+            }
+            std::fclose(f);
+        }
+        if (in.size() < sizeof(PipelineRecordMagic) ||
+            std::memcmp(in.data(), PipelineRecordMagic, sizeof(PipelineRecordMagic)) != 0) {
+            ++unresolved;
+            continue;
+        }
+        size_t at = sizeof(PipelineRecordMagic);
+        u32 layout = 0, count = 0, blob_size = 0;
+        if (!GetPod(in, at, layout) || layout != PipelineRecordLayout() || !GetPod(in, at, count) ||
+            count == 0 || count > MaxShaderStages) {
+            ++unresolved;
+            continue;
+        }
+        std::array<u64, MaxShaderStages> new_hashes{};
+        bool ok = true;
+        for (u32 n = 0; n < count && ok; ++n) {
+            u32 stage = 0;
+            u64 pgm = 0, spv = 0;
+            if (!GetPod(in, at, stage) || !GetPod(in, at, pgm) || !GetPod(in, at, spv) ||
+                stage >= MaxShaderStages) {
+                ok = false;
+                break;
+            }
+            u32 perm = ~0u;
+            if (const auto it = resolved.find(HashCombine(pgm, spv)); it != resolved.end()) {
+                perm = it->second;
+            } else {
+                perm = FindStoredPermutation(pgm, spv, stored_hashes);
+            }
+            if (perm == ~0u) {
+                ok = false;
+                break;
+            }
+            new_hashes[stage] = HashCombine(pgm, u64{perm});
+        }
+        if (!ok || !GetPod(in, at, blob_size) || blob_size != layout ||
+            in.size() - at != blob_size) {
+            ++unresolved;
+            continue;
+        }
+        std::vector<u8> blob(in.begin() + at, in.end());
+        Serialization::Archive ar{std::move(blob)};
+        GraphicsPipelineKey key{};
+        GraphicsPipeline::SerializationSupport sdata{};
+        key.Deserialize(ar);
+        sdata.Deserialize(ar);
+        for (u32 stage = 0; stage < MaxShaderStages && ok; ++stage) {
+            // Every stage the key uses must have been listed.
+            if ((key.stage_hashes[stage] != 0) != (new_hashes[stage] != 0)) {
+                ok = false;
+            }
+            key.stage_hashes[stage] = new_hashes[stage];
+        }
+        if (!ok) {
+            ++unresolved;
+            continue;
+        }
+        const u64 hash = std::hash<GraphicsPipelineKey>{}(key);
+        if (store.Exists(Storage::BlobType::PipelineKey, fmt::format("g_{:#018x}", hash))) {
+            continue;
+        }
+        RegisterPipelineData(key, hash, sdata);
+        ++restored;
+    }
+    return restored;
+}
