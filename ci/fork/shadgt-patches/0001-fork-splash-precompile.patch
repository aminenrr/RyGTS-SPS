+// FORK-PRECOMPILE: pipeline records. A graphics pipeline whose every stage was translated this
+// session is kept as <manifest>/pipelines/<pipeline hash>.pip: its key and vertex inputs (pipeline
+// state, no code) and, per stage, the program hash and the SPIR-V hash of its translation (the
+// record names). A store's permutation indices are its own, so after pre-translation the stages
+// are found again by program and SPIR-V hash and the key is stored with the new indices; the
+// PERF-038 precompile then builds it with the stored pipelines.
+static constexpr char PipelineRecordMagic[8] = {'R', 'Y', 'G', 'T', 'P', 'I', 'P', '1'};
+
+static u32 PipelineRecordLayout() {
+    static const u32 layout = [] {
+        Serialization::Archive ar;
+        GraphicsPipelineKey key{};
+        GraphicsPipeline::SerializationSupport sdata{};
+        key.Serialize(ar);
+        sdata.Serialize(ar);
+        return u32(ar.SizeBytes());
+    }();
+    return layout;
+}
+
+static void RecordManifestPipeline(
+    const GraphicsPipelineKey& key, u64 pipeline_hash,
+    const std::array<const Shader::Info*, MaxShaderStages>& infos,
+    const tsl::robin_map<size_t, std::unique_ptr<Program>>& programs,
+    const GraphicsPipeline::SerializationSupport& sdata) {
+    if (!ManifestRecordOn() || !ManifestPipelinesOn() || g_manifest_dir.empty()) {
+        return;
+    }
+    static std::mutex seen_mutex;
+    static std::unordered_set<u64> seen;
+    {
+        std::scoped_lock lk{seen_mutex};
+        if (!seen.insert(pipeline_hash).second) {
+            return;
+        }
+    }
+    struct StageRef {
+        u32 stage;
+        u64 pgm;
+        u64 spv;
+    };
+    std::vector<StageRef> stages;
+    for (u32 stage = 0; stage < MaxShaderStages; ++stage) {
+        const u64 perm_hash = key.stage_hashes[stage];
+        if (perm_hash == 0) {
+            continue;
+        }
+        const Shader::Info* info = infos[stage];
+        if (!info) {
+            return;
+        }
+        const u64 pgm = info->pgm_hash;
+        const auto it = programs.find(pgm);
+        if (it == programs.end() || !it->second) {
+            return;
+        }
+        const auto& modules = it->second->modules;
+        u64 spv = 0;
+        for (size_t i = 0; i < modules.size(); ++i) {
+            if (HashCombine(pgm, u64{i}) == perm_hash) {
+                spv = modules[i].spv_hash;
+                break;
+            }
+        }
+        if (spv == 0) {
+            return; // a stage loaded from the store (or not translated by this session)
+        }
+        stages.push_back({stage, pgm, spv});
+    }
+    if (stages.empty()) {
+        return;
+    }
+    const auto file = g_manifest_dir / "pipelines" / fmt::format("{:016x}.pip", pipeline_hash);
+    std::error_code ec;
+    if (std::filesystem::exists(file, ec)) {
+        return;
+    }
+    Serialization::Archive ar;
+    key.Serialize(ar);
+    sdata.Serialize(ar);
+    std::vector<u8> blob = ar.TakeOff();
+    std::vector<u8> out(PipelineRecordMagic, PipelineRecordMagic + sizeof(PipelineRecordMagic));
+    PutPod(out, PipelineRecordLayout());
+    PutPod(out, u32(stages.size()));
+    for (const auto& ref : stages) {
+        PutPod(out, ref.stage);
+        PutPod(out, ref.pgm);
+        PutPod(out, ref.spv);
+    }
+    PutPod(out, u32(blob.size()));
+    out.insert(out.end(), blob.begin(), blob.end());
+    std::filesystem::create_directories(file.parent_path(), ec);
+    auto temporary = file;
+    temporary += fmt::format(".{}", std::hash<std::thread::id>{}(std::this_thread::get_id()));
+    if (std::FILE* f = std::fopen(temporary.string().c_str(), "wb")) {
+        const bool ok = std::fwrite(out.data(), 1, out.size(), f) == out.size();
+        std::fclose(f);
+        if (ok) std::filesystem::rename(temporary, file, ec);
+        if (!ok || ec) std::filesystem::remove(temporary, ec);
+    }
+}
